# Skopiuj ten plik jako .env i uzupełnij dane serwera MSSQL.

PORT=3000

# Folder bazowy aplikacji. Puste = katalog, w którym leży program
# (ten z package.json). Ścieżka względna jest liczona od tego katalogu.
# APP_ROOT=.
# APP_ROOT=D:\Dane\BazaWiedzy

# Nazwy folderów względem folderu bazowego — bez ścieżek z konkretnego komputera
PHOTOS_DIR=Zdjęcia
ATTACHMENTS_DIR=Załączniki
TABLES_DIR=tabele
LOGS_DIR=logs
DATA_DIR=data

# true = używaj Microsoft SQL Server; false = lokalny plik data/state.json
MSSQL_ENABLED=true

MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=BazaWiedzyProdukcyjnej
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Opcjonalnie: pełny connection string zamiast pól powyżej
# MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=BazaWiedzyProdukcyjnej;User Id=sa;Password=...;Encrypt=false
